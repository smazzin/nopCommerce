@{
    NopHtml.AddTitleParts("About Sales Tax");
    NopHtml.AddMetaDescriptionParts("About sales tax in Portland Oregon. One of only 5 states with no sales tax.");
}

<div class="row">
    <div class="col-sm-12">
      <h1>Sales Tax</h1>
      <p>Oregon does not have a general sales or use/transaction tax. </p>
      <p>We only collect sales tax for orders shipped to Washington, California, Florida and Texas. </p>
      <p>The tax rate is based on the ship-to location of your order. <br/>Please contact us if you have any questions.</p>
    </div>
</div>
