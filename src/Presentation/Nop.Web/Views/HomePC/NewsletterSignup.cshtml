@* 
@{
	ViewBag.Title = "Portland Compressor Newsletter Sign-up";
	ViewBag.MetaDescription = "Portland Compressor Newsletter - FreshCoat. Sign-up for our monthly newsletter, FreshCoat. Special offers, events - general and/or product-line specific.";
	ViewBag.MetaKeyWords = "Portland Compressor newsletter mailing list";

	<!-- Begin MailChimp Signup Form -->
	<link href="//cdn-images.mailchimp.com/embedcode/classic-10_7.css" rel="stylesheet" type="text/css">
	<style type="text/css">
		#mc_embed_signup {
			background: #fff;
			clear: left;
			font: 14px Helvetica,Arial,sans-serif;
		}
		/*css*/
	</style>
}

    <div class="row">
        <div class="col-sm-6">


            <!-- Begin MailChimp Signup Form -->
            <div id="mc_embed_signup">
                <form action="//portlandcompressor.us3.list-manage.com/subscribe/post?u=33a8f5cdd1f5c25679c275fab&amp;id=250a561ac9" method="post" id="mc-embedded-subscribe-form" name="mc-embedded-subscribe-form" class="validate" target="_blank" novalidate>
                    <div id="mc_embed_signup_scroll">
                        <h2>Subscribe to our mailing list</h2>
                        <div class="mc-field-group">
                            <label for="mce-EMAIL">Email </label>
                            <input type="email" value="" name="EMAIL" class="required email" id="mce-EMAIL">
                        </div>
                        <div class="mc-field-group input-group">
                            <strong>Would you like to signup for our newsletter? </strong>
                            <ul>
                                <li><input type="radio" value="256" name="group[11405]" id="mce-group[11405]-11405-0"><label for="mce-group[11405]-11405-0">Yes (opt in)</label></li>
                                <li><input type="radio" value="512" name="group[11405]" id="mce-group[11405]-11405-1"><label for="mce-group[11405]-11405-1">No</label></li>
                            </ul>
                        </div>
                        <div class="mc-field-group input-group">
                            <strong>I'm interested in </strong>
                            <ul>
                                <li><input type="checkbox" value="1" name="group[11357][1]" id="mce-group[11357]-11357-0"><label for="mce-group[11357]-11357-0">Airless Paint Sprayers</label></li>
                                <li><input type="checkbox" value="2" name="group[11357][2]" id="mce-group[11357]-11357-1"><label for="mce-group[11357]-11357-1">Air Compressors</label></li>
                                <li><input type="checkbox" value="4" name="group[11357][4]" id="mce-group[11357]-11357-2"><label for="mce-group[11357]-11357-2">Pressure Washers</label></li>
                                <li><input type="checkbox" value="8" name="group[11357][8]" id="mce-group[11357]-11357-3"><label for="mce-group[11357]-11357-3">HVLP</label></li>
                                <li><input type="checkbox" value="16" name="group[11357][16]" id="mce-group[11357]-11357-4"><label for="mce-group[11357]-11357-4">Line Striping</label></li>
                            </ul>
                        </div>
                        <div class="mc-field-group input-group">
                            <strong>Alert me of </strong>
                            <ul>
                                <li><input type="checkbox" value="32" name="group[11397][32]" id="mce-group[11397]-11397-0"><label for="mce-group[11397]-11397-0">Discounts &amp; Promotions</label></li>
                                <li><input type="checkbox" value="64" name="group[11397][64]" id="mce-group[11397]-11397-1"><label for="mce-group[11397]-11397-1">New Products</label></li>
                                <li><input type="checkbox" value="128" name="group[11397][128]" id="mce-group[11397]-11397-2"><label for="mce-group[11397]-11397-2">Events</label></li>
                            </ul>
                        </div>
                        <div id="mce-responses" class="clear">
                            <div class="response" id="mce-error-response" style="display:none"></div>
                            <div class="response" id="mce-success-response" style="display:none"></div>
                        </div>    <!-- real people should not fill this in and expect good things - do not remove this or risk form bot signups-->
                        <div style="position: absolute; left: -5000px;" aria-hidden="true"><input type="text" name="b_33a8f5cdd1f5c25679c275fab_250a561ac9" tabindex="-1" value=""></div>
                        <div class="clear"><input type="submit" value="Subscribe" name="subscribe" id="mc-embedded-subscribe" class="btn btn-success"></div>
                    </div>
                </form>
            </div>

            <!--End mc_embed_signup-->

        </div>

    </div>

 *@
