@{
    NopHtml.AddTitleParts("Airless Paint Sprayers, Air Compressors, Parts, Accessories, Service and Information");
    NopHtml.AddMetaDescriptionParts("Portland Compressor has air compressors, airless paint sprayers, line-stripers, texture sprayers, HVLP equipment for industrial, commercial, residential. Parts, accessories, service. Brands like Ingersoll-Rand, Graco, Chicago-Pneumatic, BE, Rol-Air.");
    NopHtml.AddMetaKeywordParts("Graco, airless, sprayers, Ignersoll-Rand, rotary, air compressors, Chicago-Pneumatic, Magnum, TrueCoat, Ultra Max II, LineLazer, striper, striping, TexSpray, texture sprayer, HVLP, tips, hose, pressure washer, accessories, parts, Rol-Air");
    Layout = "~/Themes/Wind/Views/Shared/_ColumnsOneAlt.cshtml";
    NopHtml.AppendScriptParts(ResourceLocation.Footer, "https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.js");
    NopHtml.AppendCssFileParts("https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.css");

    <!-- Demo styles -->
    <style>
        .swiper-container {
            width: 100%;
            height: 100%;
        }

        .swiper-slide {
            text-align: center;
            font-size: 18px;
            background: #fff;

            /* Center slide text vertically */
            display: -webkit-box;
            display: -ms-flexbox;
            display: -webkit-flex;
            display: flex;
            -webkit-box-pack: center;
            -ms-flex-pack: center;
            -webkit-justify-content: center;
            justify-content: center;
            -webkit-box-align: center;
            -ms-flex-align: center;
            -webkit-align-items: center;
            align-items: center;
        }

        .swiper-slide img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    </style>
    <!-- Initialize Swiper -->
    <script type="text/javascript" asp-location="Footer">
        var swiper = new Swiper('.swiper-container', {
            slidesPerView: 1,
            spaceBetween: 50,
            parallax: true,
            // init: false,
            loop: true,
            autoplay: {
                delay: 4500,
                disableOnInteraction: true,
            },
            pagination: {
                el: '.swiper-pagination',
                clickable: true,
            },
            preloadImages: false,
            lazy: true,
            grabCursor: true,
            navigation: {
                nextEl: '.swiper-button-next',
                prevEl: '.swiper-button-prev',
            },
            breakpoints: {
                1024: {
                    slidesPerView: 1,
                    spaceBetween: 50,
                },
                768: {
                    slidesPerView: 1,
                    spaceBetween: 50,
                },
                640: {
                    slidesPerView: 1,
                    spaceBetween: 50,
                },
                320: {
                    slidesPerView: 1,
                    spaceBetween: 50,
                }
            }
        });
    </script>
}

