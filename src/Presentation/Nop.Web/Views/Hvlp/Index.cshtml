    <h1>HVLP Sprayers</h1>
    <div class="row">
        <div class="col-md-4">
            <aside class="card">
                <span class="bold h4">Also see</span>
                <ul class="list-unstyled">
                    <li><a href="@Url.Action("GracoHvlpPartsAccessories", "hvlp")">HVLP Accessories</a></li>
