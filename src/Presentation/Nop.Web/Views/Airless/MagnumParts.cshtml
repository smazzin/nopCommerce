			+'<tr><th scope="row">'+'EasyOut Filter 60 Mesh'+'</th>'  +'<td>' +(data[i].easyout_filter_60_url ? '<a href='+data[i].easyout_filter_60_url+'>' +data[i].easyout_filter_60+ '</a>' : 'N/A') + '</td></tr>'
			+'<tr><th scope="row">'+'EasyOut Filter 100 Mesh'+'</th>' +'<td>' +(data[i].easyout_filter_100_url ? '<a href='+data[i].easyout_filter_100_url+'>' +data[i].easyout_filter_100+ '</a>': 'N/A') + '</td></tr>'
			+'<tr><th scope="row">'+'EasyOut Filter 200 Mesh'+'</th>' +'<td>' +(data[i].easyout_filter_200_url ? '<a href='+data[i].easyout_filter_200_url+'>' +data[i].easyout_filter_200+ '</a>' : 'N/A') + '</td></tr>'
			+'<tr><th scope="row">'+'InstaClean Filter'+'</th>' +'<td>' +(data[i].instaclean_url ? '<a href='+data[i].instaclean_url+'>' +data[i].instaclean+ '</a>' : 'N/A') + '</td></tr>'
			+'<tr><th scope="row">'+'Gun Filter'+'</th>' +'<td>' + (data[i].gun_filter_url ? '<a href='+data[i].gun_filter_url+'>' +data[i].gun_filter+ '</a>' : 'N/A') +'</td></tr>'
			+'<tr><th scope="row">'+'Gun Filter 50 Mesh'+'</th>' +'<td>' + (data[i].gun_filter_50_url ? '<a href='+data[i].gun_filter_50_url+'>' +data[i].gun_filter_50+ '</a>' : 'N/A') +'</td></tr>'
