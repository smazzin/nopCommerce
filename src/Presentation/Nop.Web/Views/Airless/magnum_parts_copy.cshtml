<script asp-location="Footer">
var api = "../../docs/magnumParts/magnum_parts.json";
var html = '';
var result = '';
$(document).ready(function () { 
   $.ajax({
      url:api,
      method:'GET',
      cache:false,
      type:"text/json",
	  success: function(data){
		 //console.log(data);
         for(var i=0;i < data.length; i++) {
			html += '<div class="col-sm-4 my-2">'
			html +='<table id="table" class="table table-bordered table-striped table-hover">'
			+'<thead class="text-center">'
			+'<tr class="bg-light">'
			+'<th class="h3" colspan="2">'+data[i].model+'</th>'
			+'</tr>'
			+'<tr>'
			+'<th colspan="2">'+ '<div class="d-flex align-items-center justify-content-around">' + '<img height="150" alt="Graco '+data[i].model+'" src='+(data[i].image ? data[i].image : '/images/thumbs/def/default-image_415.png')+'>'+ '<div>' + (data[i].model_1_sku_url ? '<a href='+data[i].model_1_sku_url+'>' +data[i].model_1_sku+ '</a>' : data[i].model_1_sku) + '</div>' +'</div></th>'
			+'</tr>'
			+'</thead>';
			html +='<tbody>'
			+'<tr><th scope="row">'+'Spray Tip'+'</th>' +'<td>' + (data[i].sprayTip_url ? '<a href='+data[i].sprayTip_url+'>' +data[i].sprayTip+ '</a>' : 'N/A') + '</td></tr>'
			+'<tr><th scope="row">'+'Hose'+'</th>' +'<td>' +(data[i].hose_url ? '<a href='+data[i].hose_url+'>' +data[i].hose+ '</a>' : 'N/A') + '</td></tr>'
			+'<tr><th scope="row">'+'Inlet Strainer'+'</th>'+'<td>' +(data[i].inlet_strainer_url ? '<a href='+data[i].inlet_strainer_url+'>' +data[i].inlet_strainer+ '</a>' : 'N/A') + '</td></tr>'
