@model ContactUsModel
@{
    Layout = "_ColumnsOne";

    //title
    NopHtml.AddTitleParts(T("PageTitle.ContactUs").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-contact-page");
}
<div class="page contact-page container" data-type="narrow">
    <div class="page-title">
        <h1>@T("PageTitle.ContactUs")</h1>
    </div>
    <div class="page-body">
        @await Component.InvokeAsync(typeof(TopicBlockViewComponent), new { systemName = "ContactUs" })
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ContactUsTop, additionalData = Model })
        @if (Model.SuccessfullySent)
        {
            <div class="result">
                @Model.Result
            </div>
        }
        else
        {
            <form asp-route="ContactUs" method="post">
                <div asp-validation-summary="ModelOnly" class="message-error"></div>
                <div class="fieldset">
                    <div class="form-fields">
                        <div class="inputs form-floating margin-block-end-4">
                            <input asp-for="FullName" placeholder="@T("ContactUs.FullName.Hint")" class="fullname form-control" />
                            <label asp-for="FullName" asp-postfix="">
                                @T("ContactUs.FullName.Hint")
                                <nop-required />
                            </label>
                            <span asp-validation-for="FullName"></span>
                        </div>
                        <div class="inputs form-floating margin-block-end-4">
                            <input asp-for="Email" placeholder="@T("ContactUs.Email.Hint")" class="email form-control" />
                            <label asp-for="Email" asp-postfix="">
                                @T("ContactUs.Email.Hint")
                                <nop-required />
                            </label>
                            <span asp-validation-for="Email"></span>
                        </div>
                        @if (Model.SubjectEnabled)
                        {
                            <div class="inputs form-floating margin-block-end-4">
                                <input asp-for="Subject" placeholder="@T("ContactUs.Subject.Hint")" class="subject form-control" />
                                <label asp-for="Subject" asp-postfix="">
                                    @T("ContactUs.Subject.Hint")
                                    <nop-required />
                                </label>
                                <span asp-validation-for="Subject"></span>
                            </div>
                        }
                        <div class="inputs form-floating margin-block-end-4">
                            <textarea rows="10" asp-for="Enquiry" placeholder="@T("ContactUs.Enquiry.Hint")" class="enquiry form-control"></textarea>
                            <label asp-for="Enquiry" asp-postfix="">
                                @T("ContactUs.Enquiry.Hint")
                                <nop-required />
                            </label>
                            <span asp-validation-for="Enquiry"></span>
                        </div>
                        @if (Model.DisplayCaptcha)
                        {
                            <nop-captcha />
                        }
                    </div>
                </div>
                <div class="buttons">
                    <button type="submit" name="send-email" class="button-1 contact-us-button" data-type="accent-success">@T("ContactUs.Button")</button>
                </div>
            </form>
        }
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ContactUsBottom, additionalData = Model })
    </div>
</div>
