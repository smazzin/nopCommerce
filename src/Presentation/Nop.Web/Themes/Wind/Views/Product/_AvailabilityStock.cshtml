@model ProductDetailsModel
@* Using *@
@using Nop.Core.Infrastructure;
@using Nop.Services.Catalog;

@{
    @*var availability = EngineContext.Current.Resolve<ISpecificationAttributeService>().GetProductSpecificationAttributesAsync(Model.Id);*@
    var availability = await EngineContext.Current.Resolve<ISpecificationAttributeService>().GetProductSpecificationAttributesAsync(Model.Id);
    var LowStock = availability.Any(a => a.SpecificationAttributeOptionId.Equals(381));
    var InStock = availability.Any(a => a.SpecificationAttributeOptionId.Equals(382));
    var ShipFromManufacturer = availability.Any(a => a.SpecificationAttributeOptionId.Equals(383));
    var ShipFromManufacturer56BusDays = availability.Any(a => a.SpecificationAttributeOptionId.Equals(673));
    var SpecialOrder = availability.Any(a => a.SpecificationAttributeOptionId.Equals(384));
    var InStockVaries = availability.Any(a => a.SpecificationAttributeOptionId.Equals(385));
    var LowStockVaries = availability.Any(a => a.SpecificationAttributeOptionId.Equals(635));
    var Discontinued = availability.Any(a => a.SpecificationAttributeOptionId.Equals(476));

}
<div class="margin-inline-end-2">
    @if (LowStock)
    {
        NopHtml.AddHeadCustomParts("<meta name=\"addsearch-custom-field\" content=\"availability=Low Stock\" />");
        <a class="low-stock align-self-end text-decoration-none fw-bold"
           title=""
           href="#"
		   tooltip="Normally 1 to 4 on hand">
            Low Stock
        </a>
    }
    @* popover for in stock *@
    @if (InStock)
    {
        // Addsearch
        NopHtml.AddHeadCustomParts("<meta name=\"addsearch-custom-field\" content=\"availability=In Stock\" />");
        <a class="in-stock align-self-end text-decoration-none fw-bold"
           title=""
           href="#"
		   tooltip="Normally 5 or more on hand">
            In Stock
        </a>
    }
    @if (ShipFromManufacturer)
    {
        NopHtml.AddHeadCustomParts("<meta name=\"addsearch-custom-field\" content=\"availability=Ships From Manufacturer\" />");
        <a class="varies-stock align-self-end text-decoration-none fw-bold"
           title=""
           href="#"
		   tooltip="This item is NOT on hand and ships from the manufacturer">
            Ships From Manufacturer
        </a>
    }
    @if (ShipFromManufacturer56BusDays)
    {
        NopHtml.AddHeadCustomParts("<meta name=\"addsearch-custom-field\" content=\"availability=Ships From Manufacturer\" />");
        <a class="varies-stock align-self-end text-decoration-none fw-bold"
           title=""
           href="#"
		   tooltip="Item NOT in stock, Ships in about 6-7 business days">
            Ships in about 6-7 business days
        </a>
    }
    @if (SpecialOrder)
    {
        NopHtml.AddHeadCustomParts("<meta name=\"addsearch-custom-field\" content=\"availability=Special Order\" />");
        <a class="so-stock align-self-end text-decoration-none fw-bold"
           title=""
           href="#"
		   tooltip="Special Order - Item is NOT in stock<br>May take 10-14 days to ship">
            Special Order
        </a>
    }
    @if (InStockVaries)
    {
        NopHtml.AddHeadCustomParts("<meta name=\"addsearch-custom-field\" content=\"availability=In Stock - Varies\" />");
        <a class="varies-stock align-self-end text-decoration-none fw-bold"
           title=""
           href="#"
		   tooltip="Sizes not in stock will ship direct from the manufacturer">
            In Stock - Varies
        </a>
    }
    @if (LowStockVaries)
    {
        NopHtml.AddHeadCustomParts("<meta name=\"addsearch-custom-field\" content=\"availability=Low Stock - Varies\" />");
        <a class="varies-stock align-self-end text-decoration-none fw-bold"
           title=""
           href="#"
		   tooltip="Sizes not in stock will ship direct from the manufacturer">
            Low Stock - Varies by size
        </a>
    }
    @if (Discontinued)
    {
        <a class="discontinued-stock align-self-end text-decoration-none fw-bold"
           title=""
           href="#"
		   tooltip="This item has been discontinued">
            Discontinued
        </a>
    }
</div>

<style>
/* START TOOLTIP STYLES */
[tooltip] {
  position: relative; /* opinion 1 */
}

/* Applies to all tooltips */
[tooltip]::before,
[tooltip]::after {
  text-transform: none; /* opinion 2 */
  font-size: .9em; /* opinion 3 */
  line-height: 1;
  user-select: none;
  pointer-events: none;
  position: absolute;
  display: none;
  opacity: 0;
}
[tooltip]::before {
  content: '';
  border: 5px solid transparent; /* opinion 4 */
  z-index: 1001; /* absurdity 1 */
}
[tooltip]::after {
  content: attr(tooltip); /* magic! */
  
  /* 
    Let the content set the size of the tooltips 
    but this will also keep them from being obnoxious
    */
  min-width: 3em;
  max-width: 21em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding: 1ch 1.5ch;
  border-radius: .3ch;
  box-shadow: 0 1em 2em -.5em rgba(0, 0, 0, 0.35);
  background: #333;
  color: #fff;
  z-index: 1000; /* absurdity 2 */
}

/* Make the tooltips respond to hover */
[tooltip]:hover::before,
[tooltip]:hover::after {
  display: block;
}

/* don't show empty tooltips */
[tooltip='']::before,
[tooltip='']::after {
  display: none !important;
}

/* FLOW: UP */
[tooltip]:not([flow])::before,
[tooltip][flow^="up"]::before {
  bottom: 100%;
  border-bottom-width: 0;
  border-top-color: #333;
}
[tooltip]:not([flow])::after,
[tooltip][flow^="up"]::after {
  bottom: calc(100% + 5px);
}
[tooltip]:not([flow])::before,
[tooltip]:not([flow])::after,
[tooltip][flow^="up"]::before,
[tooltip][flow^="up"]::after {
  left: 50%;
  transform: translate(-50%, -.5em);
}

/* FLOW: DOWN */
[tooltip][flow^="down"]::before {
  top: 100%;
  border-top-width: 0;
  border-bottom-color: #333;
}
[tooltip][flow^="down"]::after {
  top: calc(100% + 5px);
}
[tooltip][flow^="down"]::before,
[tooltip][flow^="down"]::after {
  left: 50%;
  transform: translate(-50%, .5em);
}

/* FLOW: LEFT */
[tooltip][flow^="left"]::before {
  top: 50%;
  border-right-width: 0;
  border-left-color: #333;
  left: calc(0em - 5px);
  transform: translate(-.5em, -50%);
}
[tooltip][flow^="left"]::after {
  top: 50%;
  right: calc(100% + 5px);
  transform: translate(-.5em, -50%);
}

/* FLOW: RIGHT */
[tooltip][flow^="right"]::before {
  top: 50%;
  border-left-width: 0;
  border-right-color: #333;
  right: calc(0em - 5px);
  transform: translate(.5em, -50%);
}
[tooltip][flow^="right"]::after {
  top: 50%;
  left: calc(100% + 5px);
  transform: translate(.5em, -50%);
}

/* KEYFRAMES */
@@keyframes tooltips-vert {
  to {
    opacity: .9;
    transform: translate(-50%, 0);
  }
}

@@keyframes tooltips-horz {
  to {
    opacity: .9;
    transform: translate(0, -50%);
  }
}

/* FX All The Things */ 
[tooltip]:not([flow]):hover::before,
[tooltip]:not([flow]):hover::after,
[tooltip][flow^="up"]:hover::before,
[tooltip][flow^="up"]:hover::after,
[tooltip][flow^="down"]:hover::before,
[tooltip][flow^="down"]:hover::after {
  animation: tooltips-vert 300ms ease-out forwards;
}

[tooltip][flow^="left"]:hover::before,
[tooltip][flow^="left"]:hover::after,
[tooltip][flow^="right"]:hover::before,
[tooltip][flow^="right"]:hover::after {
  animation: tooltips-horz 300ms ease-out forwards;
}
</style>
