@model List<(string Url, string Name)>

<nav class="breadcrumb" aria-label="breadcrumb">
    <ol>
        @for (int i = 0; i < Model.Count; i++)
        {
            var (Url, Name) = Model[i];
            if (i < Model.Count - 1)
            {
                <li>
                    <a href="@Url">@Name</a>
                    <span class="delimiter">/</span>
                </li>
            }
            else
            {
                // The last breadcrumb as plain text
                <li class="active" aria-current="page">@Name</li>
            }
        }
    </ol>
</nav>